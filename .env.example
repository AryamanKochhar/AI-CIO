# PostgreSQL (canonical development database)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ai_cio
POSTGRES_PORT=5432

# Database URLs
# Local Docker Postgres (uncomment to use the local stack instead of Supabase)
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_cio

# Supabase session pooler — URL-encode special chars in password (e.g. % → %25); append ?sslmode=require
# DATABASE_URL=postgresql://USER:PASSWORD@HOST.pooler.supabase.com:5432/postgres?sslmode=require
# SUPABASE_ACCESS_TOKEN=sbp_...   # Management API token (optional; not used by the app runtime)

# Active default for new clones: local Docker Postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_cio
# Test database on the SAME local PostgreSQL instance (separate database, not a second container)
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_cio_test
POSTGRES_ADMIN_URL=postgresql://postgres:postgres@localhost:5432/postgres

# Application ports
API_PORT=8000
WEB_PORT=3000

# API URLs
API_PUBLIC_URL=http://localhost:8000
API_INTERNAL_URL=http://api:8000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
API_HOST=127.0.0.1

# Application configuration
INSTRUMENT_PATH=instruments/v1.0.json
AICIO_USER_ID=
CAS_PARSER_VERSION=cas-v1

# Market intelligence
MARKET_POLL_INTERVAL_SECONDS=300
MARKET_CACHE_TTL_SECONDS=300
OPPORTUNITY_SECTOR_CHANGE_THRESHOLD=3.0
OPPORTUNITY_RELATIVE_CHANGE_THRESHOLD=2.0
OPPORTUNITY_EXPOSURE_THRESHOLD_PCT=5.0

# LiteLLM external gateway (https://litellm-infra.valura.ai)
LLM_ENABLED=false
LLM_PROVIDER=litellm
LITELLM_BASE_URL=https://litellm-infra.valura.ai
LITELLM_API_KEY=
LLM_MODEL=

# Standalone Ling diversification prototype + Decisions equity agent
# Never commit real keys. Get a key from https://openrouter.ai/
OPENROUTER_API_KEY=
OPENROUTER_MODEL=inclusionai/ling-3.0-flash-fin
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
EQUITY_AGENT_ENABLED=true

# DhanHQ (read-only market data for scripts/dhan_sector_scorer.py + Decisions sector opportunity)
# Prefer PIN + TOTP secret so the API can mint a fresh access token at runtime.
DHAN_CLIENT_ID=
DHAN_PIN=
DHAN_TOTP_SECRET=
DHAN_ACCESS_TOKEN=
SECTOR_OPPORTUNITY_ENABLED=true

# Tax Intelligence (deterministic lots / STCG-LTCG / opportunities; Tax Agent in Decisions)
TAX_INTELLIGENCE_ENABLED=true


# Email (log provider in development — no SMTP required)
EMAIL_PROVIDER=log
EMAIL_FROM=noreply@ai-cio.local
NOTIFICATION_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
