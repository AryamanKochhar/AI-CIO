# PostgreSQL (canonical development database)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ai_cio
POSTGRES_PORT=5432

# Database URLs
# Host / local tools (alembic, MCP, pytest): connect via localhost
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_cio
# Test database on the SAME PostgreSQL instance (separate database, not a second container)
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_cio_test
POSTGRES_ADMIN_URL=postgresql://postgres:postgres@localhost:5432/postgres

# Application ports
API_PORT=8000
WEB_PORT=3000

# API URLs
# Browser and client-side Next.js requests must use localhost (not the Docker service name)
API_PUBLIC_URL=http://localhost:8000
# Server-side container-to-container requests (if needed in future SSR routes)
API_INTERNAL_URL=http://api:8000

# Next.js — browser-facing API base URL (must be reachable from the developer's browser)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# API bind address when running outside Docker
API_HOST=127.0.0.1

# Application configuration
INSTRUMENT_PATH=instruments/v1.0.json
AICIO_USER_ID=
CAS_PARSER_VERSION=cas-v1
