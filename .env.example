# PostgreSQL (canonical development database)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ai_cio
POSTGRES_PORT=5432

# Database URLs
# Local Docker Postgres (uncomment to use the local stack instead of Supabase)
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_cio

# Supabase session pooler â€” URL-encode special chars in password (e.g. % â†’ %25); append ?sslmode=require
# DATABASE_URL=postgresql://USER:PASSWORD@HOST.pooler.supabase.com:5432/postgres?sslmode=require
# SUPABASE_ACCESS_TOKEN=sbp_...   # Management API token (optional; not used by the app runtime)

# Active default for new clones: local Docker Postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_cio
# Test database on the SAME local PostgreSQL instance (separate database, not a second container)
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_cio_test
POSTGRES_ADMIN_URL=postgresql://postgres:postgres@localhost:5432/postgres

# Application ports
API_PORT=8100
WEB_PORT=3100
WEB_HOST=127.0.0.1

# API URLs
API_PUBLIC_URL=http://localhost:8100
API_INTERNAL_URL=http://api:8000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8100
API_HOST=127.0.0.1

# Application configuration
INSTRUMENT_PATH=instruments/v1.0.json
AICIO_USER_ID=
CAS_PARSER_VERSION=cas-v1

# Market intelligence
MARKET_POLL_INTERVAL_SECONDS=300
MARKET_CACHE_TTL_SECONDS=300
# Decisions are reused only while inputs/configuration match and this TTL holds.
DECISION_CACHE_TTL_SECONDS=300
OPPORTUNITY_SECTOR_CHANGE_THRESHOLD=3.0
OPPORTUNITY_RELATIVE_CHANGE_THRESHOLD=2.0
OPPORTUNITY_EXPOSURE_THRESHOLD_PCT=5.0

# Portfolio news from GNews (https://gnews.io/)
GNEWS_API_KEY=
GNEWS_LIMIT=5

# LiteLLM external gateway (https://litellm-infra.valura.ai)
LLM_ENABLED=false
LLM_PROVIDER=litellm
LITELLM_BASE_URL=https://litellm-infra.valura.ai
LITELLM_API_KEY=
LLM_MODEL=

# Decisions equity agent LLM — set EQUITY_LLM_PROVIDER to openai or openrouter
EQUITY_LLM_PROVIDER=openai
EQUITY_AGENT_ENABLED=true

# OpenAI (used when EQUITY_LLM_PROVIDER=openai)
# OPEN_API_KEY is also accepted as an alias for OPENAI_API_KEY
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# OpenRouter (used when EQUITY_LLM_PROVIDER=openrouter)
# Never commit real keys. Get a key from https://openrouter.ai/
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# DhanHQ (read-only market data for scripts/dhan_sector_scorer.py + Decisions sector opportunity)
# Prefer PIN + TOTP secret so the API can mint a fresh access token at runtime.
DHAN_CLIENT_ID=
DHAN_PIN=
DHAN_TOTP_SECRET=
DHAN_ACCESS_TOKEN=
SECTOR_OPPORTUNITY_ENABLED=true

# Tax Intelligence (deterministic lots / STCG-LTCG / opportunities; Tax Agent in Decisions)
TAX_INTELLIGENCE_ENABLED=true

# Fixed deposits + scraped bank FD rates (BankBazaar); FD Agent in Decisions
FD_INTELLIGENCE_ENABLED=true

# MFAPI NAV + dated official AMC disclosures; data cache stays outside Git.
MUTUAL_FUND_AGENT_ENABLED=true
# Optional central explanation after deterministic findings are validated.
# Uses the existing configured equity LLM provider; tests default to disabled.
DECISION_SYNTHESIS_ENABLED=true

# Financial trajectory score + projections on Decisions
TRAJECTORY_INTELLIGENCE_ENABLED=true


# Email (log provider in development â€” no SMTP required)
EMAIL_PROVIDER=log
EMAIL_FROM=noreply@ai-cio.local
NOTIFICATION_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
